[
  {
    "id": "tirets_longs",
    "nom": "Tirets longs",
    "famille": "typo",
    "regex": "[—–]",
    "conseil": "Remplacer par une virgule, un deux-points ou des parenthèses."
  },
  {
    "id": "guillemets_typographiques",
    "nom": "Guillemets typographiques",
    "famille": "typo",
    "regex": "[«»“”‘]|(?<![A-Za-zÀ-ÿœŒ])’|’(?![A-Za-zÀ-ÿœŒ])",
    "brut": true,
    "conseil": "Vérifier qu'ils sont cohérents dans tout le document et voulus à cet endroit."
  },
  {
    "id": "gras_markdown",
    "nom": "Gras markdown",
    "famille": "typo",
    "regex": "\\*\\*[^*\\n]+\\*\\*",
    "conseil": "Retirer le gras hérité du markdown."
  },
  {
    "id": "puces",
    "nom": "Puces",
    "famille": "typo",
    "regex": "^\\s*[-*•]\\s+\\S",
    "flags": "m",
    "conseil": "Revenir à la phrase quand la liste n'apporte rien au lecteur."
  },
  {
    "id": "titres",
    "nom": "Intertitres",
    "famille": "typo",
    "regex": "^#{2,3}\\s",
    "flags": "m",
    "conseil": "Garder peu d'intertitres."
  },
  {
    "id": "deux_points_explicatifs",
    "nom": "Deux-points explicatifs",
    "famille": "structure",
    "regex": "(?<=[A-Za-zÀ-ÿœŒ]) : (?=[A-Za-zÀ-ÿœŒ0-9\\\"«])",
    "conseil": "Remplacer « mot : explication » par une phrase complète."
  },
  {
    "id": "tricolons",
    "nom": "Séries « X, Y et Z »",
    "famille": "structure",
    "regex": ",\\s+[^,.;:!?\\n]{2,40}\\s+(?:et|ou)\\s+",
    "conseil": "Trop de séries à trois temps font un rythme mécanique : en garder une sur deux."
  },
  {
    "id": "series_longues",
    "nom": "Énumérations de 4 termes et plus",
    "famille": "structure",
    "regex": "(?:[^,.;:!?\\n]{2,40},\\s+){3,}[^,.;:!?\\n]{2,40}",
    "conseil": "Couper l'énumération, ou en faire une vraie liste si c'en est une."
  },
  {
    "id": "anaphores",
    "nom": "Anaphores « par X, par Y, par Z »",
    "famille": "structure",
    "regex": "\\b(par|pour|avec|sans|dans|sur|en|entre|chez|ce|qui|que)\\s[^,.;:!?\\n]{2,60},\\s+\\1\\s[^,.;:!?\\n]{2,60},\\s+\\1\\b",
    "flags": "i",
    "conseil": "Effet oratoire typique : garder un seul terme ou réécrire la phrase."
  },
  {
    "id": "puis_puis",
    "nom": "« puis…, puis… »",
    "famille": "structure",
    "regex": "\\bpuis\\b[^.!?\\n]{1,60}\\bpuis\\b",
    "flags": "i",
    "conseil": "Une étape par phrase, ou une phrase plus courte."
  },
  {
    "id": "pas_x_mais_y",
    "nom": "« pas X, mais Y »",
    "famille": "structure",
    "regex": "\\b(?:non pas|pas)\\b[^.,;:!?\\n]{2,60},?\\s+mais\\b",
    "flags": "i",
    "conseil": "Tournure que les lecteurs repèrent vite. Dire directement ce qui est."
  },
  {
    "id": "ce_n_est_pas",
    "nom": "« ce n'est pas…, c'est… »",
    "famille": "structure",
    "regex": "\\b(?:ne\\s+|n')(?:s'|se\\s)?\\w+\\s+pas\\b[^.\\n]{0,60},?\\s+(?:c'est|mais|il s'agit)",
    "flags": "i",
    "conseil": "Définition par la négation : affirmer directement."
  },
  {
    "id": "comme_les_autres",
    "nom": "« n'est pas un X comme les autres »",
    "famille": "structure",
    "regex": "\\b(?:n'|ne\\s)(?:est|sont)\\spas\\s(?:un|une|des)\\s[^.,;\\n]{2,40}\\scomme\\s(?:les|des)\\sautres",
    "flags": "i",
    "conseil": "Ouverture toute faite : commencer par un fait."
  },
  {
    "id": "chute_pour_que",
    "nom": "Chute en « , pour que… »",
    "famille": "structure",
    "regex": ",\\spour\\squ(?:e\\s|')[^.!?\\n]{3,100}[.!?]",
    "flags": "i",
    "conseil": "Fin de phrase qui justifie ou embellit : la couper, ou en faire une phrase à part."
  },
  {
    "id": "devient_un_outil",
    "nom": "« devient un outil de… »",
    "famille": "structure",
    "regex": "\\bdevien(?:t|nent|dra|dront)\\s(?:un|une|le|la|l')\\s?(?:vrai(?:e)?\\s)?(?:outil|levier|atout|moteur|pilier|alli[ée])",
    "flags": "i",
    "conseil": "Formule de conclusion : dire ce que fait l'objet, chiffre à l'appui si possible."
  },
  {
    "id": "questions",
    "nom": "Questions",
    "famille": "structure",
    "regex": "\\?",
    "conseil": "Question rhétorique : la remplacer par l'affirmation."
  },
  {
    "id": "appel_direct",
    "nom": "Adresse au lecteur (vous, votre)",
    "famille": "structure",
    "regex": "\\b(?:vous|votre|vos)\\b",
    "flags": "i",
    "conseil": "Hors courrier, passer à l'impersonnel ou au « nous »."
  },
  {
    "id": "imperatifs",
    "nom": "Impératifs incitatifs",
    "famille": "structure",
    "regex": "^\\s*(?:ajoutez|cr[eé]ez|listez|testez|reformulez|auditez|remplacez|commencez|pensez|imaginez)\\b",
    "flags": "mi",
    "conseil": "Impératif en tête de ligne : reformuler en constat."
  },
